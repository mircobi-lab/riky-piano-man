// SYNTH BASS - Riky Piano Man (originale, oscillatori di sfizz)
<global> lokey=0 hikey=127 pitch_keycenter=60 ampeg_attack=0.003 ampeg_decay=0.8 ampeg_sustain=55 ampeg_release=0.12 amp_veltrack=70 fil_type=lpf_2p cutoff=260 resonance=3 fil_veltrack=1800 fileg_decay=0.25 fileg_sustain=0 fileg_depth=2600 volume=-12
<region> sample=*saw
<region> sample=*square tune=7 volume=-6
<region> sample=*sine transpose=-12 volume=-4
